#!/usr/bin/env python3
"""
pre-commit hook: if combat-atlas.html is staged, regenerate README combat section.

Install once:
  git config core.hooksPath .githooks
  chmod +x .githooks/pre-commit
"""

import subprocess, sys, re, os, json

def staged_files():
    r = subprocess.run(["git", "diff", "--cached", "--name-only"], capture_output=True, text=True)
    return r.stdout.strip().split("\n")

def main():
    if "combat-atlas.html" not in staged_files():
        sys.exit(0)  # nothing to do

    atlas_path = os.path.join(os.path.dirname(__file__), "..", "combat-atlas.html")
    if not os.path.exists(atlas_path):
        print("[hook] combat-atlas.html not found, skipping README update")
        sys.exit(0)

    with open(atlas_path, "r", encoding="utf-8") as f:
        html = f.read()

    # ── Extract CLASSES array ──────────────────────────────────────────────────
    classes_match = re.search(r'const CLASSES\s*=\s*(\[[\s\S]*?\]);', html)
    abilities_match = re.search(r'const AB\s*=\s*(\[[\s\S]*?\]);', html)
    synergies_match = re.search(r'const SYNERGIES\s*=\s*(\[[\s\S]*?\]);', html)

    class_count = 0
    ability_count = 0
    synergy_count = 0
    class_names = []

    if classes_match:
        # Count entries by counting {id: patterns
        entries = re.findall(r'\{id:\d+,name:"([^"]+)"', classes_match.group(1))
        class_count = len(entries)
        class_names = entries

    if abilities_match:
        ability_count = len(re.findall(r'\{id:\d+,', abilities_match.group(1)))

    if synergies_match:
        synergy_count = len(re.findall(r'\{a:\d+,', synergies_match.group(1)))

    # ── Build README combat section ────────────────────────────────────────────
    cls_line = " · ".join([f"**{c}**" for c in class_names]) if class_names else f"{class_count} hero classes"

    combat_section = f"""## ⚔️ Combat Atlas

Live reference: [playcrossworlds.com/combat/](https://playcrossworlds.com/combat/)

| Stat | Value |
|------|-------|
| Hero Classes | {class_count} |
| Abilities | {ability_count} ({ability_count - 8} class + 8 shared) |
| Synergy Pairs | {synergy_count} |

**Classes:** {cls_line}

> Auto-generated by `.githooks/pre-commit` — edit `combat-atlas.html`, not this section.
"""

    # ── Update README.md ──────────────────────────────────────────────────────
    readme_path = os.path.join(os.path.dirname(__file__), "..", "README.md")
    if not os.path.exists(readme_path):
        # Create minimal README if missing
        with open(readme_path, "w", encoding="utf-8") as f:
            f.write(f"# Crossworlds BCE\n\nMultiplayer RPG — Unity 6 + Mirror/KCP\n\n{combat_section}")
        print("[hook] Created README.md with combat section")
    else:
        with open(readme_path, "r", encoding="utf-8") as f:
            content = f.read()

        # Replace existing combat section or append
        pattern = r'## ⚔️ Combat Atlas[\s\S]*?(?=\n## |\Z)'
        if re.search(pattern, content):
            content = re.sub(pattern, combat_section.strip(), content)
        else:
            content = content.rstrip() + "\n\n" + combat_section

        with open(readme_path, "w", encoding="utf-8") as f:
            f.write(content)
        print("[hook] README.md combat section updated")

    # Also update the Quick Links line that shows ability/synergy counts
    with open(readme_path, "r", encoding="utf-8") as f:
        content = f.read()
    updated = re.sub(
        r'(Combat Atlas \(live\).*?https://playcrossworlds\.com/combat)[^\|]*(\|)',
        rf'\1 — {class_count} classes · {ability_count} abilities · {synergy_count} synergy pairs \2',
        content
    )
    if updated != content:
        with open(readme_path, "w", encoding="utf-8") as f:
            f.write(updated)

    # Stage the updated README
    subprocess.run(["git", "add", "README.md"])
    print("[hook] README.md staged")

main()
