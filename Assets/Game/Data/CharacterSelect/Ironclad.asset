  className: Ironclad
  roleTagline: "Tank  \xB7  Vanguard  \xB7  Frontline Fortress"
  loreDescription: "An indestructible wall of armored might, the Ironclad absorbs
    punishment so their allies don't have to. Masters of aggro and mitigation, they
    hold the line against overwhelming odds \u2014 then punish overcommitment with
    a devastating counter-charge."
  classColor: {r: 0.42, g: 0.68, b: 0.88, a: 1}
  classColorDark: {r: 0.08, g: 0.18, b: 0.3, a: 1}
