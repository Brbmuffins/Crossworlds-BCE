  coreAbilities:
  - icon: {fileID: 21300000, guid: cb025973e7e3f114aa3db0378956aad8, type: 3}
    abilityName: Ice Spikes
    description: Launch a burst of arcane ice shards in a forward cone. Hold to charge
      — fully charged shards deal up to 50 damage.
  - icon: {fileID: 21300000, guid: 8bd1e081148c0f642a307bafee93747b, type: 3}
    abilityName: Void Maw
    description: Tear open a void singularity that pulls nearby enemies inward and
      pulses for damage 4 times before collapsing.
  - icon: {fileID: 21300000, guid: 04841b8a9cae96b42aa2a2689b689515, type: 3}
    abilityName: Meteor Shower
    description: Call down a barrage of arcane meteors that hammer a large area 10
      times over 3 seconds.
  deployableName: Ice Guardian
  deployableDescription: Summon an Ice Guardian that attacks nearby enemies until
    destroyed. 30 second cooldown.
  deployableIcon: {fileID: 21300000, guid: 0ebf1c5c7d608714992ac370f9bf838c, type: 3}
