# Create API credentials in Robinhood Web Classic > Crypto > API settings.
# Begin with read-only actions. Never enable withdrawals.
ROBINHOOD_API_KEY=
ROBINHOOD_PRIVATE_KEY_BASE64=
ROBINHOOD_API_VERSION=v2
ROBINHOOD_API_BASE_URL=https://trading.robinhood.com

# Safety defaults. Live order placement is intentionally not implemented.
BOT_MODE=read_only
TARGET_NET_RETURN=0.09
MAX_RISK_PER_TRADE=0.005
MAX_PORTFOLIO_DRAWDOWN=0.05

# Optional one-way tracking channel. Treat this URL as a secret.
DISCORD_WEBHOOK_URL=
DISCORD_HEALTH_WEBHOOK_URL=
DISCORD_CALENDAR_WEBHOOK_URL=
