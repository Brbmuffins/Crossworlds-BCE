    [System.Serializable] class GenericResponse     { public bool success; public string error; }
    [System.Serializable] class CreateGuildRequest  { public int characterId; public string name; public string tag; }
    [System.Serializable] class JoinRequest         { public int characterId; public int guildId; }
    [System.Serializable] class LeaveRequest        { public int characterId; }
    [System.Serializable] class MotdRequest         { public int characterId; public string motd; }
    [System.Serializable] class KickRequest         { public int characterId; public int targetCharacterId; }

    [System.Serializable]
    class GuildData
    {
        public int          guildId;
        public string       name;
        public string       tag;
        public string       motd;
        public string       myRole;   // "leader" | "member"
        public GuildMember[] members;
    }

    [System.Serializable]
    class GuildMember
    {
        public int    characterId;
        public string characterName;
        public int    level;
        public string role;  // "leader" | "member"
    }

    [System.Serializable]
    class GuildSummary
    {
        public int    id;
        public string name;
        public string tag;
        public int    memberCount;
    }
