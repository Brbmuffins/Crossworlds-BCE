// COPY TO: Assets/Game/UI/QuestLogUI.cs
#if !UNITY_SERVER
using System.Collections;
using System.Collections.Generic;
using UnityEngine;
using UnityEngine.UI;
using UnityEngine.Networking;
using TMPro;

/// <summary>
/// QuestLogUI — Q key toggle. Three tabs: Available / Active / Complete.
/// Self-bootstrapping, DontDestroyOnLoad.
///
/// Available:  GET /api/quests/available/:characterId
/// Active:     GET /api/quests/active/:characterId   (progress bars)
/// Completed:  GET /api/quests/completed/:characterId
/// Accept:     POST /api/quests/accept
/// </summary>
public class QuestLogUI : MonoBehaviour
{
    public static QuestLogUI Instance { get; private set; }

    // ── Bootstrap ─────────────────────────────────────────────────────────────
    [RuntimeInitializeOnLoadMethod(RuntimeInitializeLoadType.AfterSceneLoad)]
    static void Bootstrap()
    {
        if (Instance != null) return;
        var go = new GameObject("[QuestLogUI]");
        DontDestroyOnLoad(go);
        Instance = go.AddComponent<QuestLogUI>();
    }

    // ── State ─────────────────────────────────────────────────────────────────
    private bool _open = false;
    private int  _characterId;
    private int  _activeTab = 0; // 0=Available 1=Active 2=Completed

    // ── UI refs ───────────────────────────────────────────────────────────────
    private Canvas          _canvas;
    private GameObject      _root;
    private CanvasGroup     _cg;
    private Transform       _contentArea;
    private TextMeshProUGUI _errorLabel;
    private Button[]        _tabButtons = new Button[3];

    static readonly string[] TabNames  = { "Available", "Active", "Completed" };
    static readonly Color    TabActive = new Color(0.2f, 0.5f, 0.8f);
    static readonly Color    TabIdle   = new Color(0.1f, 0.12f, 0.18f);

    string ServerUrl => $"http://{PlayerPrefs.GetString("serverIP", "localhost")}:3000";
    string Token     => PlayerPrefs.GetString("jwt_token", "");

    // ── Lifecycle ─────────────────────────────────────────────────────────────
    void Awake() => BuildUI();

    void Update()
    {
        if (Input.GetKeyDown(KeyCode.Q) && !IsTypingInUI())
            Toggle();
    }

    bool IsTypingInUI()
    {
        var sel = UnityEngine.EventSystems.EventSystem.current?.currentSelectedGameObject;
        return sel != null && sel.GetComponent<TMP_InputField>() != null;
    }

    // ── Open / Close ──────────────────────────────────────────────────────────
    void Toggle()
    {
        _open = !_open;
        if (_open) OpenPanel();
        else       ClosePanel();
    }

    void OpenPanel()
    {
        _characterId = PlayerPrefs.GetInt("SelectedCharacter", 0);
        _cg.alpha = 1f; _cg.interactable = true; _cg.blocksRaycasts = true;
        ShowTab(_activeTab);
    }

    void ClosePanel()
    {
        _cg.alpha = 0f; _cg.interactable = false; _cg.blocksRaycasts = false;
    }

    /// <summary>Called by QuestTracker on quest complete if log is open.</summary>
    public void RefreshIfOpen()
    {
        if (_open) ShowTab(_activeTab);
    }

    // ── Tabs ──────────────────────────────────────────────────────────────────
    void ShowTab(int tab)
    {
        _activeTab = tab;
        for (int i = 0; i < _tabButtons.Length; i++)
            _tabButtons[i].GetComponent<Image>().color = (i == tab) ? TabActive : TabIdle;

        ClearContent();
        HideError();

        switch (tab)
        {
            case 0: StartCoroutine(LoadAvailable()); break;
            case 1: StartCoroutine(LoadActive());    break;
            case 2: StartCoroutine(LoadCompleted()); break;
        }
    }

    void ClearContent()
    {
        foreach (Transform child in _contentArea)
            Destroy(child.gameObject);
    }

    // ── Available tab ─────────────────────────────────────────────────────────
    IEnumerator LoadAvailable()
    {
        using var req = UnityWebRequest.Get($"{ServerUrl}/api/quests/available/{_characterId}");
        req.SetRequestHeader("Authorization", $"Bearer {Token}");
        yield return req.SendWebRequest();

        if (req.result != UnityWebRequest.Result.Success)
        { ShowError(req.error); yield break; }

        var resp = JsonUtility.FromJson<AvailableListResponse>(req.downloadHandler.text);
        if (!resp.success) { ShowError(resp.error); yield break; }

        if (resp.data == null || resp.data.Length == 0)
        { AddNoContentLabel("No quests available right now."); yield break; }

        foreach (var q in resp.data)
            AddAvailableRow(q);
    }

    void AddAvailableRow(AvailableQuest q)
    {
        var row = new GameObject($"QuestRow_{q.id}");
        row.transform.SetParent(_contentArea, false);
        var le = row.AddComponent<LayoutElement>();
        le.minHeight = 72f; le.preferredHeight = 72f;
        var rect = row.AddComponent<RectTransform>();
        rect.sizeDelta = new Vector2(0f, 72f);
        var bg = row.AddComponent<Image>();
        bg.color = new Color(0.08f, 0.1f, 0.14f);

        // Type badge
        var badge = new GameObject("Badge");
        badge.transform.SetParent(row.transform, false);
        var bRect = badge.AddComponent<RectTransform>();
        bRect.anchorMin = new Vector2(0f, 0.6f); bRect.anchorMax = new Vector2(0.18f, 1f);
        bRect.offsetMin = new Vector2(4f, -2f); bRect.offsetMax = new Vector2(-2f, -4f);
        badge.AddComponent<Image>().color = QuestTypeBadgeColor(q.quest_type);
        var badgeTxt = badge.AddComponent<TextMeshProUGUI>();
        badgeTxt.text = q.quest_type.ToUpper();
        badgeTxt.fontSize = 8f; badgeTxt.fontStyle = FontStyles.Bold;
        badgeTxt.color = Color.white; badgeTxt.alignment = TextAlignmentOptions.Center;

        // Name
        var nameGO = new GameObject("Name");
        nameGO.transform.SetParent(row.transform, false);
        var nRect = nameGO.AddComponent<RectTransform>();
        nRect.anchorMin = new Vector2(0.2f, 0.55f); nRect.anchorMax = new Vector2(0.75f, 1f);
        nRect.offsetMin = nRect.offsetMax = Vector2.zero;
        var nameTxt = nameGO.AddComponent<TextMeshProUGUI>();
        nameTxt.text = q.name; nameTxt.fontSize = 12f;
        nameTxt.fontStyle = FontStyles.Bold; nameTxt.color = Color.white;

        // Description
        var descGO = new GameObject("Desc");
        descGO.transform.SetParent(row.transform, false);
        var dRect = descGO.AddComponent<RectTransform>();
        dRect.anchorMin = new Vector2(0f, 0.1f); dRect.anchorMax = new Vector2(0.75f, 0.55f);
        dRect.offsetMin = new Vector2(4f, 0f); dRect.offsetMax = Vector2.zero;
        var descTxt = descGO.AddComponent<TextMeshProUGUI>();
        descTxt.text = q.description; descTxt.fontSize = 9f;
        descTxt.color = new Color(0.7f, 0.7f, 0.7f);

        // Rewards
        var rewGO = new GameObject("Rewards");
        rewGO.transform.SetParent(row.transform, false);
        var rRect = rewGO.AddComponent<RectTransform>();
        rRect.anchorMin = new Vector2(0f, 0f); rRect.anchorMax = new Vector2(0.75f, 0.12f);
        rRect.offsetMin = new Vector2(4f, 2f); rRect.offsetMax = Vector2.zero;
        var rewTxt = rewGO.AddComponent<TextMeshProUGUI>();
        rewTxt.text = $"Rewards: +{q.reward_xp} XP  +{q.reward_gold}g";
        rewTxt.fontSize = 9f; rewTxt.color = new Color(0.8f, 0.75f, 0.3f);

        // Accept button
        var acceptGO = new GameObject("Accept");
        acceptGO.transform.SetParent(row.transform, false);
        var aRect = acceptGO.AddComponent<RectTransform>();
        aRect.anchorMin = new Vector2(0.78f, 0.2f); aRect.anchorMax = new Vector2(0.98f, 0.8f);
        aRect.offsetMin = aRect.offsetMax = Vector2.zero;
        acceptGO.AddComponent<Image>().color = new Color(0.1f, 0.4f, 0.15f);
        var acceptBtn = acceptGO.AddComponent<Button>();
        var capturedQ = q;
        acceptBtn.onClick.AddListener(() => StartCoroutine(AcceptQuest(capturedQ)));
        var aTxtGO = new GameObject("L");
        aTxtGO.transform.SetParent(acceptGO.transform, false);
        StretchFull(aTxtGO);
        var aTxt = aTxtGO.AddComponent<TextMeshProUGUI>();
        aTxt.text = "Accept"; aTxt.fontSize = 11f;
        aTxt.color = Color.white; aTxt.alignment = TextAlignmentOptions.Center;
    }

    IEnumerator AcceptQuest(AvailableQuest q)
    {
        var body = JsonUtility.ToJson(new AcceptRequest { characterId = _characterId, questId = q.id });
        using var req = new UnityWebRequest($"{ServerUrl}/api/quests/accept", "POST");
        req.uploadHandler   = new UploadHandlerRaw(System.Text.Encoding.UTF8.GetBytes(body));
        req.downloadHandler = new DownloadHandlerBuffer();
        req.SetRequestHeader("Content-Type", "application/json");
        req.SetRequestHeader("Authorization", $"Bearer {Token}");
        yield return req.SendWebRequest();

        if (req.result != UnityWebRequest.Result.Success) { ShowError(req.error); yield break; }
        var resp = JsonUtility.FromJson<GenericResponse>(req.downloadHandler.text);
        if (!resp.success) { ShowError(resp.error); yield break; }

        HideError();
        // Refresh active quest cache in QuestTracker
        yield return StartCoroutine(RefreshActiveCache());
        ShowTab(1); // switch to Active tab
    }

    // ── Active tab ────────────────────────────────────────────────────────────
    IEnumerator LoadActive()
    {
        using var req = UnityWebRequest.Get($"{ServerUrl}/api/quests/active/{_characterId}");
        req.SetRequestHeader("Authorization", $"Bearer {Token}");
        yield return req.SendWebRequest();

        if (req.result != UnityWebRequest.Result.Success) { ShowError(req.error); yield break; }
        var resp = JsonUtility.FromJson<ActiveListResponse>(req.downloadHandler.text);
        if (!resp.success) { ShowError(resp.error); yield break; }

        // Update QuestTracker cache
        if (resp.data != null)
            QuestTracker.SetActiveQuests(new List<ActiveQuest>(resp.data));

        if (resp.data == null || resp.data.Length == 0)
        { AddNoContentLabel("No active quests. Accept quests from the Available tab."); yield break; }

        foreach (var q in resp.data)
            AddActiveRow(q);
    }

    void AddActiveRow(ActiveQuest q)
    {
        var row = new GameObject($"ActiveRow_{q.id}");
        row.transform.SetParent(_contentArea, false);
        var le = row.AddComponent<LayoutElement>();
        le.minHeight = 80f; le.preferredHeight = 80f;
        row.AddComponent<Image>().color = new Color(0.08f, 0.12f, 0.1f);

        // Name
        var nameGO = new GameObject("Name");
        nameGO.transform.SetParent(row.transform, false);
        var nRect = nameGO.AddComponent<RectTransform>();
        nRect.anchorMin = new Vector2(0f, 0.68f); nRect.anchorMax = Vector2.one;
        nRect.offsetMin = new Vector2(8f, 0f); nRect.offsetMax = new Vector2(-8f, -4f);
        var nameTxt = nameGO.AddComponent<TextMeshProUGUI>();
        nameTxt.text = q.name; nameTxt.fontSize = 12f;
        nameTxt.fontStyle = FontStyles.Bold; nameTxt.color = Color.white;

        // Description
        var descGO = new GameObject("Desc");
        descGO.transform.SetParent(row.transform, false);
        var dRect = descGO.AddComponent<RectTransform>();
        dRect.anchorMin = new Vector2(0f, 0.42f); dRect.anchorMax = new Vector2(1f, 0.68f);
        dRect.offsetMin = new Vector2(8f, 0f); dRect.offsetMax = new Vector2(-8f, 0f);
        var descTxt = descGO.AddComponent<TextMeshProUGUI>();
        descTxt.text = q.description; descTxt.fontSize = 9f;
        descTxt.color = new Color(0.65f, 0.65f, 0.65f);

        // Progress bar
        var sliderGO = new GameObject("ProgressSlider");
        sliderGO.transform.SetParent(row.transform, false);
        var sRect = sliderGO.AddComponent<RectTransform>();
        sRect.anchorMin = new Vector2(0f, 0.18f); sRect.anchorMax = new Vector2(1f, 0.38f);
        sRect.offsetMin = new Vector2(8f, 0f); sRect.offsetMax = new Vector2(-8f, 0f);
        var slider = sliderGO.AddComponent<Slider>();
        slider.minValue = 0f; slider.maxValue = q.target_count;
        slider.value    = q.progress; slider.interactable = false;

        var slBg = new GameObject("BG"); slBg.transform.SetParent(sliderGO.transform, false);
        StretchFull(slBg); slBg.AddComponent<Image>().color = new Color(0.15f, 0.15f, 0.15f);
        slider.targetGraphic = slBg.GetComponent<Image>();

        var fillArea = new GameObject("FA"); fillArea.transform.SetParent(sliderGO.transform, false);
        StretchFull(fillArea);
        var fill = new GameObject("Fill"); fill.transform.SetParent(fillArea.transform, false);
        StretchFull(fill);
        var fillImg = fill.AddComponent<Image>();
        fillImg.color = new Color(0.2f, 0.7f, 0.3f);
        slider.fillRect = fill.GetComponent<RectTransform>();

        // Progress text
        var progGO = new GameObject("ProgText");
        progGO.transform.SetParent(row.transform, false);
        var pRect = progGO.AddComponent<RectTransform>();
        pRect.anchorMin = new Vector2(0f, 0.02f); pRect.anchorMax = new Vector2(1f, 0.18f);
        pRect.offsetMin = new Vector2(8f, 0f); pRect.offsetMax = new Vector2(-8f, 0f);
        var progTxt = progGO.AddComponent<TextMeshProUGUI>();
        progTxt.text = $"{q.progress} / {q.target_count}  |  +{q.reward_xp} XP  +{q.reward_gold}g";
        progTxt.fontSize = 9f; progTxt.color = new Color(0.7f, 0.85f, 0.5f);
    }

    // ── Completed tab ─────────────────────────────────────────────────────────
    IEnumerator LoadCompleted()
    {
        using var req = UnityWebRequest.Get($"{ServerUrl}/api/quests/completed/{_characterId}");
        req.SetRequestHeader("Authorization", $"Bearer {Token}");
        yield return req.SendWebRequest();

        if (req.result != UnityWebRequest.Result.Success) { ShowError(req.error); yield break; }
        var resp = JsonUtility.FromJson<ActiveListResponse>(req.downloadHandler.text);
        if (!resp.success) { ShowError(resp.error); yield break; }

        if (resp.data == null || resp.data.Length == 0)
        { AddNoContentLabel("No completed quests yet."); yield break; }

        foreach (var q in resp.data)
        {
            var row = new GameObject($"CompRow_{q.id}");
            row.transform.SetParent(_contentArea, false);
            var le = row.AddComponent<LayoutElement>(); le.minHeight = 44f;
            row.AddComponent<Image>().color = new Color(0.06f, 0.1f, 0.06f);

            var go = new GameObject("Label"); go.transform.SetParent(row.transform, false);
            StretchFull(go);
            var rr = go.GetComponent<RectTransform>();
            rr.offsetMin = new Vector2(8f, 4f); rr.offsetMax = new Vector2(-8f, -4f);
            var txt = go.AddComponent<TextMeshProUGUI>();
            txt.text = $"✓  {q.name}";
            txt.fontSize = 11f; txt.color = new Color(0.5f, 0.9f, 0.5f);
        }
    }

    // ── Helpers ───────────────────────────────────────────────────────────────
    IEnumerator RefreshActiveCache()
    {
        using var req = UnityWebRequest.Get($"{ServerUrl}/api/quests/active/{_characterId}");
        req.SetRequestHeader("Authorization", $"Bearer {Token}");
        yield return req.SendWebRequest();
        if (req.result != UnityWebRequest.Result.Success) yield break;
        var resp = JsonUtility.FromJson<ActiveListResponse>(req.downloadHandler.text);
        if (resp.success && resp.data != null)
            QuestTracker.SetActiveQuests(new List<ActiveQuest>(resp.data));
    }

    void AddNoContentLabel(string msg)
    {
        var go = new GameObject("NoContent");
        go.transform.SetParent(_contentArea, false);
        var le = go.AddComponent<LayoutElement>(); le.minHeight = 50f;
        var rect = go.AddComponent<RectTransform>(); rect.sizeDelta = new Vector2(0f, 50f);
        var txt = go.AddComponent<TextMeshProUGUI>();
        txt.text = msg; txt.fontSize = 11f;
        txt.color = new Color(0.5f, 0.5f, 0.5f);
        txt.alignment = TextAlignmentOptions.Center;
    }

    Color QuestTypeBadgeColor(string type) => type switch
    {
        "kill"    => new Color(0.7f, 0.2f, 0.2f),
        "gather"  => new Color(0.2f, 0.5f, 0.2f),
        "collect" => new Color(0.2f, 0.3f, 0.7f),
        "escort"  => new Color(0.6f, 0.5f, 0.1f),
        _         => new Color(0.3f, 0.3f, 0.3f),
    };

    void ShowError(string msg)
    {
        _errorLabel.text = msg; _errorLabel.gameObject.SetActive(true);
    }
    void HideError() => _errorLabel.gameObject.SetActive(false);

    void StretchFull(GameObject go)
    {
        var r = go.GetComponent<RectTransform>() ?? go.AddComponent<RectTransform>();
        r.anchorMin = Vector2.zero; r.anchorMax = Vector2.one;
        r.offsetMin = r.offsetMax = Vector2.zero;
    }

    // ── Build UI ──────────────────────────────────────────────────────────────
    void BuildUI()
    {
        _canvas = gameObject.AddComponent<Canvas>();
        _canvas.renderMode  = RenderMode.ScreenSpaceOverlay;
        _canvas.sortingOrder = 110;
        gameObject.AddComponent<CanvasScaler>().uiScaleMode = CanvasScaler.ScaleMode.ScaleWithScreenSize;
        gameObject.AddComponent<GraphicRaycaster>();

        _root = new GameObject("QuestLogRoot");
        _root.transform.SetParent(transform, false);
        var rootRect = _root.AddComponent<RectTransform>();
        rootRect.anchorMin = new Vector2(0.05f, 0.08f);
        rootRect.anchorMax = new Vector2(0.45f, 0.95f);
        rootRect.offsetMin = rootRect.offsetMax = Vector2.zero;

        _cg = _root.AddComponent<CanvasGroup>();
        _cg.alpha = 0f; _cg.interactable = false; _cg.blocksRaycasts = false;
        _root.AddComponent<Image>().color = new Color(0.05f, 0.06f, 0.09f, 0.97f);

        // Title
        var titleGO = new GameObject("Title"); titleGO.transform.SetParent(_root.transform, false);
        var tRect = titleGO.AddComponent<RectTransform>();
        tRect.anchorMin = new Vector2(0f, 0.93f); tRect.anchorMax = Vector2.one;
        tRect.offsetMin = tRect.offsetMax = Vector2.zero;
        var tTxt = titleGO.AddComponent<TextMeshProUGUI>();
        tTxt.text = "QUEST LOG"; tTxt.fontSize = 16f; tTxt.fontStyle = FontStyles.Bold;
        tTxt.color = Color.white; tTxt.alignment = TextAlignmentOptions.Center;

        // Tab buttons
        for (int i = 0; i < 3; i++)
        {
            float xMin = i / 3f, xMax = (i + 1) / 3f;
            var tabGO = new GameObject($"Tab_{i}"); tabGO.transform.SetParent(_root.transform, false);
            var tabRect = tabGO.AddComponent<RectTransform>();
            tabRect.anchorMin = new Vector2(xMin, 0.87f); tabRect.anchorMax = new Vector2(xMax, 0.93f);
            tabRect.offsetMin = new Vector2(2f, 0f); tabRect.offsetMax = new Vector2(-2f, 0f);
            tabGO.AddComponent<Image>().color = i == 0 ? TabActive : TabIdle;
            var btn = tabGO.AddComponent<Button>();
            int captured = i;
            btn.onClick.AddListener(() => ShowTab(captured));
            _tabButtons[i] = btn;

            var lblGO = new GameObject("L"); lblGO.transform.SetParent(tabGO.transform, false);
            StretchFull(lblGO);
            var lbl = lblGO.AddComponent<TextMeshProUGUI>();
            lbl.text = TabNames[i]; lbl.fontSize = 11f;
            lbl.color = Color.white; lbl.alignment = TextAlignmentOptions.Center;
        }

        // Scroll content area
        var scrollGO = new GameObject("ScrollView"); scrollGO.transform.SetParent(_root.transform, false);
        var scrollRect_t = scrollGO.AddComponent<RectTransform>();
        scrollRect_t.anchorMin = new Vector2(0f, 0.04f); scrollRect_t.anchorMax = new Vector2(1f, 0.87f);
        scrollRect_t.offsetMin = new Vector2(4f, 0f); scrollRect_t.offsetMax = new Vector2(-4f, 0f);
        var scrollRect = scrollGO.AddComponent<ScrollRect>();
        scrollRect.horizontal = false; scrollRect.vertical = true;

        var viewport = new GameObject("Viewport"); viewport.transform.SetParent(scrollGO.transform, false);
        StretchFull(viewport); viewport.AddComponent<Image>().color = Color.clear;
        viewport.AddComponent<Mask>().showMaskGraphic = false;
        scrollRect.viewport = viewport.GetComponent<RectTransform>();

        var content = new GameObject("Content"); content.transform.SetParent(viewport.transform, false);
        var contentRect = content.AddComponent<RectTransform>();
        contentRect.anchorMin = new Vector2(0f, 1f); contentRect.anchorMax = Vector2.one;
        contentRect.pivot     = new Vector2(0.5f, 1f);
        contentRect.offsetMin = contentRect.offsetMax = Vector2.zero;
        var vlg = content.AddComponent<VerticalLayoutGroup>();
        vlg.spacing = 4f; vlg.childControlWidth = true; vlg.childForceExpandWidth = true;
        vlg.childControlHeight = false;
        content.AddComponent<ContentSizeFitter>().verticalFit = ContentSizeFitter.FitMode.PreferredSize;
        scrollRect.content = contentRect;
        _contentArea = content.transform;

        // Error label
        var errGO = new GameObject("Error"); errGO.transform.SetParent(_root.transform, false);
        var eRect = errGO.AddComponent<RectTransform>();
        eRect.anchorMin = new Vector2(0f, 0f); eRect.anchorMax = new Vector2(1f, 0.04f);
        eRect.offsetMin = eRect.offsetMax = Vector2.zero;
        _errorLabel = errGO.AddComponent<TextMeshProUGUI>();
        _errorLabel.fontSize = 9f; _errorLabel.color = new Color(1f, 0.4f, 0.4f);
        _errorLabel.alignment = TextAlignmentOptions.Center;
        errGO.SetActive(false);
    }

    // ── JSON types ────────────────────────────────────────────────────────────
    [System.Serializable] class AvailableListResponse { public bool success; public string error; public AvailableQuest[] data; }
    [System.Serializable] class ActiveListResponse    { public bool success; public string error; public ActiveQuest[] data;    }
    [System.Serializable] class AcceptRequest         { public int characterId; public int questId; }
    [System.Serializable] class GenericResponse       { public bool success; public string error; }
}
#endif
