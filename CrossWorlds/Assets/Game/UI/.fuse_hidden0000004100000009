using System.Collections;
using System.Collections.Generic;
using UnityEngine;
using UnityEngine.Networking;

/// <summary>
/// QuestTracker — static class, no MonoBehaviour.
/// Call QuestTracker.NotifyProgress(type, targetId, amount) from:
///   - EnemyController.DeathSequence()  (kill quests)
///   - ResourceNode on gather success   (gather quests)
///   - WorldItem on pickup              (collect quests)
///
/// Finds any active quest matching type+targetId and POSTs /api/quests/progress.
/// If complete, shows popup and awards XP/gold locally via PlayerProgressManager.
/// </summary>
public static class QuestTracker
{
    // ── Active quest cache ────────────────────────────────────────────────────
    // Populated by QuestLogUI.OnQuestAccepted — keeps QuestTracker decoupled from HTTP
    private static List<ActiveQuest> _activeQuests = new List<ActiveQuest>();

    public static void SetActiveQuests(List<ActiveQuest> quests)
    {
        _activeQuests = quests ?? new List<ActiveQuest>();
    }

    // ── Core call ─────────────────────────────────────────────────────────────
    public static void NotifyProgress(string questType, string targetId, int amount = 1)
    {
#if UNITY_SERVER
        return;
#endif
        foreach (var q in _activeQuests)
        {
            if (q.quest_type != questType) continue;
            if (!string.IsNullOrEmpty(q.target_id) && q.target_id != targetId) continue;

            // Run the coroutine via a helper MonoBehaviour
            QuestTrackerRunner.Instance?.StartCoroutine(
                PostProgress(q, amount));
        }
    }

    static IEnumerator PostProgress(ActiveQuest quest, int amount)
    {
        int charId = PlayerPrefs.GetInt("SelectedCharacter", 0);
        string serverUrl = $"http://{PlayerPrefs.GetString("serverIP", "localhost")}:3000";
        string token     = PlayerPrefs.GetString("jwt_token", "");

        var body = JsonUtility.ToJson(new ProgressRequest
            { characterId = charId, questId = quest.id, amount = amount });

        using var req = new UnityWebRequest($"{serverUrl}/api/quests/progress", "POST");
        req.uploadHandler   = new UploadHandlerRaw(System.Text.Encoding.UTF8.GetBytes(body));
        req.downloadHandler = new DownloadHandlerBuffer();
        req.SetRequestHeader("Content-Type", "application/json");
        req.SetRequestHeader("Authorization", $"Bearer {token}");
        yield return req.SendWebRequest();

        if (req.result != UnityWebRequest.Result.Success)
        {
            Debug.LogWarning($"[QUEST] Progress POST failed: {req.error}");
            yield break;
        }

        var resp = JsonUtility.FromJson<ProgressResponse>(req.downloadHandler.text);
        if (!resp.success)
        {
            Debug.LogWarning($"[QUEST] Progress error: {resp.error}");
            yield break;
        }

        quest.progress = resp.data.progress;
        Debug.Log($"[QUEST] {quest.name}: {quest.progress}/{quest.target_count}");

        if (resp.data.completed)
            yield return QuestTrackerRunner.Instance?.StartCoroutine(CompleteQuest(quest, resp.data));
    }

    static IEnumerator CompleteQuest(ActiveQuest quest, ProgressData data)
    {
        int charId = PlayerPrefs.GetInt("SelectedCharacter", 0);
        string serverUrl = $"http://{PlayerPrefs.GetString("serverIP", "localhost")}:3000";
        string token     = PlayerPrefs.GetString("jwt_token", "");

        var body = JsonUtility.ToJson(new CompleteRequest { characterId = charId, questId = quest.id });
        using var req = new UnityWebRequest($"{serverUrl}/api/quests/complete", "POST");
        req.uploadHandler   = new UploadHandlerRaw(System.Text.Encoding.UTF8.GetBytes(body));
        req.downloadHandler = new DownloadHandlerBuffer();
        req.SetRequestHeader("Content-Type", "application/json");
        req.SetRequestHeader("Authorization", $"Bearer {token}");
        yield return req.SendWebRequest();

        // Award locally regardless of network result
        if (quest.reward_xp > 0)
            PlayerProgressManager.Local?.AwardXp(quest.reward_xp);
        if (quest.reward_gold > 0)
            PlayerProgressManager.Local?.AwardGold(quest.reward_gold);

        // Remove from active list
        _activeQuests.Remove(quest);

        // Show completion popup
        QuestCompletePopup.Show(quest.name, quest.reward_xp, quest.reward_gold);

        // Refresh quest log if open
        QuestLogUI.Instance?.RefreshIfOpen();

        Debug.Log($"[QUEST] COMPLETE: {quest.name} — +{quest.reward_xp}xp +{quest.reward_gold}g");
    }

    // ── JSON types ────────────────────────────────────────────────────────────
    [System.Serializable] class ProgressRequest  { public int characterId; public int questId; public int amount; }
    [System.Serializable] class CompleteRequest  { public int characterId; public int questId; }
    [System.Serializable] class ProgressResponse { public bool success; public string error; public ProgressData data; }
    [System.Serializable] class ProgressData     { public int progress; public bool completed; }
}

// ── Data types (shared between QuestTracker and QuestLogUI) ───────────────────
[System.Serializable]
public class ActiveQuest
{
    public int    id;
    public string name;
    public string description;
    public string quest_type;   // "kill", "gather", "collect", "escort"
    public string target_id;    // e.g. "enemy_grunt", "material_copper_shard"
    public int    target_count;
    public int    progress;
    public int    reward_xp;
    public int    reward_gold;
}

[System.Serializable]
public class AvailableQuest
{
    public int    id;
    public string name;
    public string description;
    public string quest_type;
    public int    target_count;
    public int    reward_xp;
    public int    reward_gold;
}

// ── Runner MonoBehaviour (auto-created, runs coroutines for the static class) ──
public class QuestTrackerRunner : MonoBehaviour
{
    public static QuestTrackerRunner Instance { get; private set; }

    [RuntimeInitializeOnLoadMethod(RuntimeInitializeLoadType.AfterSceneLoad)]
    static void Bootstrap()
    {
#if !UNITY_SERVER
        if (Instance != null) return;
        var go = new GameObject("[QuestTrackerRunner]");
        DontDestroyOnLoad(go);
        Instance = go.AddComponent<QuestTrackerRunner>();
#endif
    }
}

// ── Quest Complete Popup ───────────────────────────────────────────────────────
public class QuestCompletePopup : MonoBehaviour
{
    private static QuestCompletePopup _instance;
    private TMPro.TextMeshProUGUI _label;
    private CanvasGroup _cg;

    [RuntimeInitializeOnLoadMethod(RuntimeInitializeLoadType.AfterSceneLoad)]
    static void Bootstrap()
    {
#if !UNITY_SERVER
        if (_instance != null) return;
        var go = new GameObject("[QuestCompletePopup]");
        DontDestroyOnLoad(go);
        _instance = go.AddComponent<QuestCompletePopup>();
#endif
    }

    void Awake()
    {
        var canvas = gameObject.AddComponent<Canvas>();
        canvas.renderMode = RenderMode.ScreenSpaceOverlay;
        canvas.sortingOrder = 130;
        gameObject.AddComponent<GraphicRaycaster>();

        var panel = new GameObject("Panel");
        panel.transform.SetParent(transform, false);
        var rect = panel.AddComponent<RectTransform>();
        rect.anchorMin = new Vector2(0.3f, 0.72f);
        rect.anchorMax = new Vector2(0.7f, 0.82f);
        rect.offsetMin = rect.offsetMax = Vector2.zero;
        panel.AddComponent<UnityEngine.UI.Image>().color = new Color(0.1f, 0.3f, 0.1f, 0.92f);

        var txtGO = new GameObject("Text");
        txtGO.transform.SetParent(panel.transform, false);
        var tr = txtGO.AddComponent<RectTransform>();
        tr.anchorMin = Vector2.zero; tr.anchorMax = Vector2.one;
        tr.offsetMin = new Vector2(8f, 4f); tr.offsetMax = new Vector2(-8f, -4f);
        _label = txtGO.AddComponent<TMPro.TextMeshProUGUI>();
        _label.fontSize = 13f;
        _label.color = Color.white;
        _label.alignment = TMPro.TextAlignmentOptions.Center;

        _cg = panel.AddComponent<CanvasGroup>();
        _cg.alpha = 0f; _cg.blocksRaycasts = false;
    }

    public static void Show(string questName, int xp, int gold)
    {
        if (_instance == null) return;
        _instance._label.text = $"✓ Quest Complete: {questName}\n+{xp} XP   +{gold}g";
        _instance.StopAllCoroutines();
        _instance.StartCoroutine(_instance.FadeInOut());
    }

    IEnumerator FadeInOut()
    {
        _cg.alpha = 1f;
        yield return new WaitForSeconds(3f);
        float t = 0f;
        while (t < 1f)
        {
            t += Time.deltaTime * 1.5f;
            _cg.alpha = 1f - t;
            yield return null;
        }
        _cg.alpha = 0f;
    }
}
